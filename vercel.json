{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/agent-demo",
      "destination": "/agent-demo.html"
    },
    {
      "source": "/scholarship-guides",
      "destination": "/scholarship-guides/index.html"
    },
    {
      "source": "/scholarship-guides/",
      "destination": "/scholarship-guides/index.html"
    },
    {
      "source": "/scholarship-guides/high-school-juniors/",
      "destination": "/scholarship-guides/high-school-juniors.html"
    },
    {
      "source": "/scholarship-guides/texas-scholarships/",
      "destination": "/scholarship-guides/texas-scholarships.html"
    },
    {
      "source": "/scholarship-guides/scholarships-by-gpa/",
      "destination": "/scholarship-guides/scholarships-by-gpa.html"
    },
    {
      "source": "/scholarship-guides/scholarships-by-major/",
      "destination": "/scholarship-guides/scholarships-by-major.html"
    },
    {
      "source": "/((?![.]well-known(?:/|$)|api(?:/|$)|assets/|scholarship-guides(?:/|$)|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\""
        },
        {
          "key": "Link",
          "value": "<https://scholarship-scout.org/.well-known/api-catalog>; rel=\"api-catalog\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://scholarship-scout.org/.well-known/api-catalog>; rel=\"api-catalog\""
        }
      ]
    }
  ]
}
