{
  "name": "scholarship-scout",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/check-focused-tests.mjs && node --import ./scripts/register-tsx-coverage-loader.mjs --enable-source-maps --test tests/*.test.mjs",
    "check:deprecated": "node scripts/check-deprecated-code.mjs",
    "test:coverage": "npm run test:coverage:react && node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-include='src/**/*.mjs' --test-coverage-functions=100 --test-coverage-lines=85 --test-coverage-branches=100 tests/*.test.mjs",
    "test:coverage:react": "node scripts/run-tsx-coverage.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.4.5",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=26.7.0 <27"
  }
}
